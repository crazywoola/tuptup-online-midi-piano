{
  "name": "tuptup-online-midi-piano",
  "version": "0.1.0",
  "description": "A browser-based multitrack MIDI workstation for TupTup TS01-MIDI controllers.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crazywoola/tuptup-online-midi-piano.git"
  },
  "bugs": {
    "url": "https://github.com/crazywoola/tuptup-online-midi-piano/issues"
  },
  "homepage": "https://github.com/crazywoola/tuptup-online-midi-piano#readme",
  "keywords": [
    "web-midi",
    "web-audio",
    "midi-controller",
    "piano",
    "tuptup"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/soundfont.test.mjs tests/song-mode.test.mjs",
    "audit:samples": "node scripts/audit-samples.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "10.8.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0",
    "vinext": "^1.0.0-beta.5",
    "vite": "^8.2.1",
    "wrangler": "^4.122.0"
  },
  "type": "module"
}
